{
    "$schema":  "https://recomplauncher.com/schema/recomplauncher.json",
    "format":  1,
    "name":  "Clock Tower PC Enhanced - VeladeLibra",
    "repo":  "VeladeLibra/clock-tower-pc-enhanced",
    "inputs":  [
                   {
                       "label":  "Clock Tower (USA) SLUS-00539 - select CUE with BIN next to it",
                       "id":  "game",
                       "formats":  [
                                       {
                                           "type":  "file",
                                           "extensions":  [
                                                              "cue"
                                                          ]
                                       }
                                   ],
                       "role":  "game"
                   }
               ],
    "start":  {
                  "args":  [
                               "--disc",
                               "{input:game}"
                           ],
                  "program":  [
                                  "ClockTower_PC_Enhanced_Launcher.exe"
                              ],
                  "env":  {
                              "PSX_INTERNAL_RESOLUTION":  "2x"
                          }
              }
}